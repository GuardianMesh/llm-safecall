# Set these in the process environment or load .env explicitly; it is not read automatically.
LLM_PROVIDER=mock
# For openai or anthropic, choose a model available to your provider account.
LLM_MODEL=

# Local development keys; use your deployment's secret store in production.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional rate limit
# LLM_RATE_PER_SEC=5

# Output policy
LLM_ALLOW_SHELL=false
LLM_URL_ALLOWLIST=https://docs.example.com/

# Manual and provider-reported costs; unknown costs are not estimated.
# Optional: units must match the costs supplied to Budget.add(). This is not a billing cap.
# LLM_BUDGET_DAILY=100
# LLM_BUDGET_PATH=.llm_safecall_budget.json
